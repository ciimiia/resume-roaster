# Copy to .env.local and fill in. See lib/env.ts for how each var is read
# and validated — importing something that needs a missing var throws a
# clear error naming exactly which one and how to get it.

# ── Core (required) ─────────────────────────────────────────────────────
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL of this deployment. Used for canonical links, OG tags,
# sitemap, robots.txt, and the OpenRouter HTTP-Referer header.
# Local dev: leave unset, defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://resume-roaster-tan-six.vercel.app

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=

# ── AI (OpenRouter) ─────────────────────────────────────────────────────
# Without this, /api/analyze falls back to static canned data and
# /api/cover-letter returns an error — the rest of the app still works.
OPENROUTER_API_KEY=

# ── Existing data store (Upstash Redis / Vercel KV) ─────────────────────
# Users, saved analyses, cover letters, blog posts, site content, stats.
# Without these, every page that reads KV degrades gracefully (safeGet
# falls back after a 1.5s timeout) rather than crashing.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Cron ─────────────────────────────────────────────────────────────────
# Bearer token the daily blog-post cron job (vercel.json) must send.
CRON_SECRET=

# ── Postgres (Neon) — Phase 0 scaffold, not required by any route yet ────
# Create from the Vercel dashboard: Storage → Neon, then `vercel env pull`.
DATABASE_URL=

# ── File storage (Vercel Blob) — Phase 0 scaffold, not wired in yet ──────
# Create from the Vercel dashboard: Storage → Blob, then `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
