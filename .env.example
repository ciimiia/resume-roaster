# Copy to .env.local and fill in. See lib/env.ts for how each var is read
# and validated — importing something that needs a missing var throws a
# clear error naming exactly which one and how to get it.

# ── Core (required) ─────────────────────────────────────────────────────
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL of this deployment. Used for canonical links, OG tags,
# sitemap, robots.txt, and the OpenRouter HTTP-Referer header.
# Local dev: leave unset, defaults to http://localhost:3000
# Production: set via the Vercel dashboard — current value as of this
# writing is https://resume-roaster-tan-six.vercel.app (check Vercel's
# project settings for whatever it's actually set to now; never hardcode
# this value in code, it must stay sourced from this env var).
NEXT_PUBLIC_SITE_URL=

# Shows the homepage's "AI-matched jobs" banner + footer link. Default off
# (unset/anything other than "true") — turn on once a real ingestion run
# has actually populated the `jobs` table, otherwise it advertises an
# empty feed. Set to "true" to enable.
NEXT_PUBLIC_SHOW_JOBS_BANNER=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=

# ── AI (OpenRouter) ─────────────────────────────────────────────────────
# Without this, /api/analyze falls back to static canned data,
# /api/cover-letter returns an error, resume parsing fails (NO_API_KEY),
# and job embedding/matching skip silently — the rest of the app still works.
OPENROUTER_API_KEY=

# Model for resume parsing (lib/resumeParsing.ts) and roast analysis
# (app/api/analyze/route.ts). Must be a paid model — see the comment in
# lib/env.ts: "openrouter/free" has no route under the data_collection:deny
# constraint these calls require (resume/job text is personal/third-party
# data, routed only to providers that don't retain/train on it).
# Default: openai/gpt-4o-mini
OPENROUTER_MODEL=

# Model for job/profile embeddings (lib/embeddings.ts, Phase 2b). Must
# output 1536-dimensional vectors to match the `vector(1536)` columns in
# lib/db/schema.ts — changing this to a different-dimension model needs a
# new migration. Confirmed OpenRouter's embeddings endpoint accepts the
# same data_collection:deny provider-routing field as chat completions.
# Default: openai/text-embedding-3-small ($0.02/1M tokens)
EMBEDDING_MODEL=

# Model for the job-match LLM re-rank step (lib/matching/rerank.ts, Phase
# 2b). Same data_collection:deny requirement. Default: same as
# OPENROUTER_MODEL if unset.
RERANK_MODEL=

# Model for resume tailoring (lib/tailoring/tailor.ts, Phase 4). Same
# data_collection:deny requirement. Default: same as OPENROUTER_MODEL if unset.
TAILOR_MODEL=

# Model for the tailored cover letter generator (lib/tailoring/coverLetter.ts,
# Phase 4). Same requirement. Default: same as OPENROUTER_MODEL if unset.
TAILOR_COVER_LETTER_MODEL=

# ── Cron ─────────────────────────────────────────────────────────────────
# Bearer token the cron jobs (vercel.json: daily blog-post generation,
# daily job ingestion + embedding) must send. Fails closed if unset — a
# cron route rejects every request rather than accepting unauthenticated ones.
CRON_SECRET=

# ── Job ingestion — Adzuna adapter (Phase 2a, optional) ────────────────
# Both vars must be set together or the Adzuna adapter is skipped cleanly
# (not an error, not seeded by default either way). A free key is
# evaluation-only — commercial/revenue-generating use requires a separate
# paid Adzuna licence agreement; see lib/jobIngestion/adapters/adzuna.ts.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Postgres (Neon) — required ────────────────────────────────────────────
# Primary data store: users, resumes/profiles/job-preferences, shared roast
# results, cover letters, blog posts, site content, visit stats, rate
# limits, job listings + sources + embeddings (pgvector) + match cache +
# saved/hidden jobs + blocked companies.
# Create from the Vercel dashboard: Storage → Neon, then `vercel env pull`.
DATABASE_URL=

# ── File storage (Vercel Blob) — resume uploads (Phase 1b) ────────────────
# Create from the Vercel dashboard: Storage → Blob, then `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
